#! /bin/bash

# check_script - called by make check

DESTDIR=$1

libdir=$(pkg-config pure --variable libdir)
installdir=${DESTDIR}${libdir}/pure

# Linux might need this. Include both the module install dir (for the
# freshly-built .so modules) and the runtime libdir (for libpure.so),
# so this works when Pure is installed to a non-standard prefix.
export LD_LIBRARY_PATH=${installdir}:${DESTDIR}${libdir}:${libdir}:${LD_LIBRARY_PATH}
# OS X needs this
export DYLD_LIBRARY_PATH=${installdir}:${DESTDIR}${libdir}:${libdir}:${DYLD_LIBRARY_PATH}

curdir=$PWD

# Invoked indirectly via the trap below.
# shellcheck disable=SC2329
cleanup() {
  local status=$?
  rm -rf "${DESTDIR}"
  exit "${status}"
}
trap cleanup ALRM HUP INT TERM

# run ut for stlvec
cd pure-stlvec/ut || exit 1
pure -I"${installdir}" -L"${installdir}" -x ut_all.pure
stlvec_ec=$?

cd "${curdir}" || exit 1

echo

cd pure-stlmap/uts || exit 1
pure -I"${installdir}" -L"${installdir}" -x check_uts.pure uts_*.pure
stlmap_ec=$?

cd "${curdir}" || exit 1

rm -rf "${DESTDIR}"

if [ "${stlvec_ec}" -ne 0 ] || [ "${stlmap_ec}" -ne 0 ]
then
  echo
  echo --- MAKE CHECK FAILED ---
  exit 1
else
  echo
  echo --- MAKE CHECK PASSED ---
  exit 0
fi
