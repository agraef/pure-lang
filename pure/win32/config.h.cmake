/* config.h for MSVC builds of Pure, generated by CMakeLists.txt. The
   autotools build makes its config.h with configure; this file sets the
   same macros to what configure finds on x86_64 Windows with the MSVC CRT
   (ucrtbase) and the vcpkg x64-windows libraries. */

#define PACKAGE_NAME "pure"
#define PACKAGE_TARNAME "pure"
#define PACKAGE_VERSION "@PURE_VERSION@"
#define PACKAGE_STRING "pure @PURE_VERSION@"
#define PACKAGE_BUGREPORT ""
#define PACKAGE_URL ""

#define HOST "@PURE_HOST@"
#define DLLEXT ".dll"
#define EXEEXT ".exe"
#define LLVM_VERSION "@LLVM_PACKAGE_VERSION@"
#define TOOL_PREFIX "@PURE_TOOL_PREFIX@"
#define PURE_PIC ""

#define SIZEOF_VOID_P 8

/* The Microsoft C runtime resets a signal to SIG_DFL before it calls the
   handler, so the handler has to reinstall itself. */
#define MUST_REINSTALL_SIGHANDLERS 1
#define SIZEOF_LONG 4
#define SIZEOF_SIZE_T 8

#define HAVE_GMP_H 1
#define HAVE_LIBGMP 1
#define HAVE_MPFR_H 1
#define HAVE_LIBMPFR 1
#define HAVE_ICONV 1
#define ICONV_CONST

#define HAVE_FASTCC 1

/* The LLVM headers configure checks for. */
#define HAVE_LLVM_IR_IRBUILDER_H 1
#define HAVE_LLVM_IR_VERIFIER_H 1
#define HAVE_LLVM_LINKER_LINKER_H 1
#define HAVE_LLVM_SUPPORT_RAW_OSTREAM_H 1
#define HAVE_LLVM_SUPPORT_RAW_OS_OSTREAM_H 1
#define HAVE_LLVM_SUPPORT_TARGETSELECT_H 1
#define HAVE_LLVM_SUPPORT_DYNAMICLIBRARY_H 1
#define HAVE_LLVM_IR_DATALAYOUT_H 1
#define HAVE_ALLOCA_H 1 /* win32/alloca.h */

/* readline (vcpkg readline-win32, GNU readline 5.0) */
#cmakedefine HAVE_LIBREADLINE 1
#cmakedefine USE_READLINE 1
#cmakedefine HAVE_READLINE_READLINE_H 1
#cmakedefine HAVE_READLINE_HISTORY 1
#cmakedefine HAVE_READLINE_HISTORY_H 1
#cmakedefine HAVE_HISTORY_SET_HISTORY_STATE 1

/* The CRT has _ftime, not gettimeofday/nanosleep/usleep; runtime.cc then
   uses ftime and Sleep. */
#define HAVE_FTIME 1
#define HAVE_FSTAT 1
#define HAVE_STRUCT_STAT_ST_RDEV 1
#define HAVE_DIRENT_H 1
#define HAVE_READDIR 1
#define HAVE_DAYLIGHT_IN_TIME_H 1

/* Not available with MSVC: strptime (strptime.c is compiled in), mkstemp
   (util.cc has a replacement), langinfo, sys/wait.h, _Complex. */
